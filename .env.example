# Address reachable from the Nuxt server (not from the visitor’s browser).
NUXT_WIREMOCK_BASE_URL=http://localhost:8080
# Use one authentication mode if your WireMock admin API requires it.
NUXT_WIREMOCK_AUTH_TOKEN=
NUXT_WIREMOCK_USERNAME=
NUXT_WIREMOCK_PASSWORD=
# Durable app-owned history. The Docker image uses /app/.data/wiretap.sqlite.
NUXT_HISTORY_DATABASE_PATH=./.data/wiretap.sqlite
